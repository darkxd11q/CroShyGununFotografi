<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Giriş Yap · CroShy Günün Fotoğrafı</title>
  <%- include('partials/theme-init') %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar', { showSocial: false }) %>

  <main class="login-stage">
    <div class="login-card">
      <span class="eyebrow">CroShy Günün Fotoğrafı</span>
      <h1>Giriş Yap</h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/giris">
        <div class="field">
          <label for="username">Kullanıcı Adı</label>
          <input type="text" id="username" name="username" autocomplete="username" maxlength="20" value="<%= username || '' %>" autofocus required />
        </div>
        <div class="field">
          <label for="password">Şifre</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn">Giriş Yap</button>
      </form>

      <a href="/kayit" class="back-home-link">Hesabın yok mu? Kayıt ol →</a>
      <a href="/hesap-kurtar" class="back-home-link">Şifreni mi unuttun? Hesabını kurtar →</a>
    </div>
  </main>
  <script src="/js/theme.js"></script>
</body>
</html>
