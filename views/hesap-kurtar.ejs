<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hesap Kurtar · CroShy Günün Fotoğrafı</title>
  <%- include('partials/theme-init') %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar', { showSocial: false }) %>

  <main class="login-stage">
    <div class="login-card profile-card">
      <span class="eyebrow">CroShy Günün Fotoğrafı</span>

      <% if (newRecoveryCode) { %>
        <h1>Şifren Yenilendi</h1>
        <p class="status-line">Yeni şifrenle giriş yapabilirsin. Aşağıda yeni kurtarma kodun var — eski kod artık geçersiz.</p>
        <%- include('partials/recovery-code', { recoveryCode: newRecoveryCode }) %>
        <a href="/" class="btn" style="display:block; text-align:center; text-decoration:none; margin-top:22px;">Siteye Devam Et</a>
      <% } else { %>
        <h1>Hesabını Kurtar</h1>

        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/hesap-kurtar">
          <div class="field">
            <label for="username">Kullanıcı Adı</label>
            <input type="text" id="username" name="username" autocomplete="username" maxlength="20" value="<%= username || '' %>" autofocus required />
          </div>
          <div class="field">
            <label for="recoveryCode">Kurtarma Kodu</label>
            <input type="text" id="recoveryCode" name="recoveryCode" placeholder="XXXX-XXXX-XXXX" required />
          </div>
          <div class="field">
            <label for="newPassword">Yeni Şifre</label>
            <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" minlength="8" required />
            <small class="field-hint">En az 8 karakter.</small>
          </div>
          <div class="field">
            <label for="newPasswordConfirm">Yeni Şifre (Tekrar)</label>
            <input type="password" id="newPasswordConfirm" name="newPasswordConfirm" autocomplete="new-password" minlength="8" required />
          </div>
          <button type="submit" class="btn">Şifreyi Sıfırla</button>
        </form>

        <a href="/eposta-ile-kurtar" class="back-home-link">Kurtarma kodun yok mu? E-posta ile kurtar →</a>
        <a href="/giris" class="back-home-link">← Giriş sayfasına dön</a>
      <% } %>
    </div>
  </main>
  <script src="/js/theme.js"></script>
</body>
</html>
