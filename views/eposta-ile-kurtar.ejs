<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>E-posta ile Kurtar · CroShy Günün Fotoğrafı</title>
  <%- include('partials/theme-init') %>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/topbar', { showSocial: false }) %>

  <main class="login-stage">
    <div class="login-card">
      <span class="eyebrow">CroShy Günün Fotoğrafı</span>
      <h1>E-posta ile Kurtar</h1>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } else { %>
        <p class="status-line">Hesabına kayıtlı e-posta adresini gir, şifre sıfırlama bağlantısını gönderelim.</p>
        <form method="POST" action="/eposta-ile-kurtar">
          <div class="field">
            <label for="email">E-posta</label>
            <input type="email" id="email" name="email" autocomplete="email" maxlength="100" autofocus required />
          </div>
          <button type="submit" class="btn">Bağlantı Gönder</button>
        </form>
      <% } %>

      <a href="/hesap-kurtar" class="back-home-link">Kurtarma kodun var mı? Onunla kurtar →</a>
      <a href="/giris" class="back-home-link">← Giriş sayfasına dön</a>
    </div>
  </main>
  <script src="/js/theme.js"></script>
</body>
</html>
